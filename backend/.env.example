# Backend Server Configuration
PORT=4000
NODE_ENV=development

# Supabase Free Tier Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key is STRICTLY used by backend only for background tasks/admin scripts.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Provider-Independent Free-Tier AI APIs (Zero-cost only)
# Get keys for free at:
# 1. Google AI Studio: https://aistudio.google.com/app/apikey
# 2. Groq Cloud: https://console.groq.com/keys
# 3. OpenRouter: https://openrouter.ai/keys (Free tier models: :free)
# 4. Cerebras: https://cloud.cerebras.ai/
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Fallback & Resilience Flags
ENABLE_MOCK_FALLBACK=true
AI_REQUEST_TIMEOUT_MS=15000
CIRCUIT_BREAKER_COOLDOWN_SEC=60
MAX_RETRIES_PER_PROVIDER=2
