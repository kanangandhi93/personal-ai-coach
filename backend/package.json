  "dependencies": {
    "@coach/shared": "file:../packages/shared",
    "@supabase/supabase-js": "^2.42.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
